# Private dynamic env vars
API_URL="http://127.0.0.1:8000/api/v1"

ACROSS_SERVER_ID="a13bbcdd-798d-43cd-bb2a-6b10347db2a3"
ACROSS_SERVER_SECRET="local-service-account-key"

# ALTCHA captcha HMAC secret. Optional locally (a built-in dev key is used when unset).
# In deployed environments this is read from SSM at /${APP_ENV}/${ALTCHA_HMAC_KEY_PATH}.
# ALTCHA_HMAC_KEY=""
# ALTCHA_HMAC_KEY_PATH="frontend/altcha/hmac_key"

# build time static public env vars must have a PUBLIC_ prefix
PUBLIC_BUILD_VERSION="local"
PUBLIC_RUNTIME_ENV="local"
PUBLIC_DEFAULT_LOG_LEVEL="debug"