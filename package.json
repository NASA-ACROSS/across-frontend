{
    "name": "across-frontend",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "build:docker": "docker build -t frontend:local-test --no-cache --platform linux/amd64 --build-arg BUILD_ENV=local-test --build-arg BUILD_VERSION=12345 .",
        "preview": "vite preview",
        "test": "npm run test:integration && npm run test:unit",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier . --check",
        "format:fix": "prettier . --write",
        "lint": "eslint",
        "lint:all": "eslint .",
        "lint:fix": "eslint . --fix",
        "test:integration": "playwright test",
        "test:unit": "vitest",
        "prepare": "husky"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@sveltejs/adapter-auto": "^3.0.0",
        "@sveltejs/adapter-node": "^5.0.1",
        "@sveltejs/kit": "^2.0.0",
        "@sveltejs/vite-plugin-svelte": "^3.0.0",
        "@tailwindcss/typography": "^0.5.16",
        "@tailwindcss/vite": "^4.1.11",
        "@types/d3": "^7.4.3",
        "@types/eslint": "^9.6.1",
        "@types/eslint__js": "^8.42.3",
        "@types/lodash": "^4.17.4",
        "@types/luxon": "^3.4.2",
        "@typescript-eslint/eslint-plugin": "^8.55.0",
        "@typescript-eslint/parser": "^8.55.0",
        "cron-parser": "^5.3.1",
        "cronstrue": "^3.3.0",
        "d3": "^7.9.0",
        "daisyui": "^5.0.43",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-svelte": "^3.15.0",
        "husky": "^9.0.11",
        "jwt-decode": "^4.0.0",
        "lint-staged": "^15.2.4",
        "lodash": "^4.17.21",
        "luxon": "^3.7.2",
        "prettier": "^3.1.1",
        "prettier-plugin-svelte": "^3.1.2",
        "svelte": "^4.2.19",
        "svelte-check": "^3.6.0",
        "svelte-tabular-table": "^1.0.6",
        "sveltekit-rate-limiter": "^0.5.1",
        "tailwindcss": "^4.1.11",
        "tslib": "^2.4.1",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.55.0",
        "vite": "^5.1.7",
        "vitest": "^1.2.0"
    },
    "type": "module",
    "dependencies": {
        "@aws-sdk/client-ssm": "^3.999.0",
        "dotenv": "^17.3.1"
    }
}
