ACROSS_SERVER_HOST="localhost"
ACROSS_SERVER_PORT=1080
ACROSS_SERVER_ID="dummy-id"
ACROSS_SERVER_SECRET="dummy-secret"

MOCKSERVER_PORT=1080
MOCKSERVER_NAMESPACE_HEADER="X-MockServer-Namespace"

# Live ACROSS server OpenAPI spec, used to seed MockServer's baseline (fallback) expectations.
ACROSS_OPENAPI_SPEC_URL="https://api.across.sciencecloud.nasa.gov/v1/openapi.json"

# build time static public env vars must have a PUBLIC_ prefix
PUBLIC_PRETTY_LOGS=0
PUBLIC_BUILD_VERSION="test"
PUBLIC_RUNTIME_ENV="test"
CI="true"

# test specific env vars
ACROSS_TEST_ACCESS_TOKEN="dummy-token"
MOCKSERVER_NAMESPACE_HEADER="X-MockServer-Namespace"
# Set to 1 to allow for sveltekit server to output to console during testing
DEBUG=0