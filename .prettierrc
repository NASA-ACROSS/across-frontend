{
    "plugins": ["prettier-plugin-svelte"],
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "printWidth": 140,
    "overrides": [
        {
            "files": ["*.{yml,yaml}"],
            "options": {
                "parser": "yaml",
                "tabWidth": 2
            }
        }
    ]
}
