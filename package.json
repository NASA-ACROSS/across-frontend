{
    "name": "across-frontend",
    "version": "1.10.0",
    "private": true,
    "scripts": {
        "dev": "vite dev",
        "build": "BUILD_ENV=deploy vite build",
        "build:docker": "docker build --target local -t across-frontend:latest --no-cache --platform linux/amd64 --build-arg=BUILD_VERSION=local .",
        "compose": "docker compose down && docker compose build && docker compose up -d",
        "preview": "vite preview",
        "test": "npm run test:integration && npm run test:unit",
        "sync": "svelte-kit sync",
        "check": "PUBLIC_BUILD_VERSION=check PUBLIC_RUNTIME_ENV=check npm run sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "PUBLIC_BUILD_VERSION=check PUBLIC_RUNTIME_ENV=check svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier . --check",
        "format:fix": "prettier . --write",
        "lint": "eslint",
        "lint:all": "eslint .",
        "lint:fix": "eslint . --fix",
        "test:e2e": "npm run sync && playwright test",
        "test:integration": "npm run sync && playwright test",
        "test:unit": "vitest",
        "test:generate": "npm run compose && playwright codegen localhost:5173",
        "prepare": "husky"
    },
    "dependencies": {
        "pino": "^10.3.1"
    },
    "devDependencies": {
        "@aws-sdk/client-ssm": "^3.999.0",
        "@mockserver/testcontainers": "^7.6.0",
        "@playwright/test": "^1.62.0",
        "@sveltejs/adapter-node": "^6.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/typography": "^0.5.16",
        "@tailwindcss/vite": "^4.3.3",
        "@types/d3": "^7.4.3",
        "@types/eslint": "^9.6.1",
        "@types/eslint__js": "^8.42.3",
        "@types/lodash": "^4.17.4",
        "@types/luxon": "^3.4.2",
        "@types/node": "^26.4.0",
        "@typescript-eslint/eslint-plugin": "^8.57.0",
        "@typescript-eslint/parser": "^8.57.0",
        "cron-parser": "^5.3.1",
        "cronstrue": "^3.3.0",
        "d3": "^7.9.0",
        "daisyui": "^5.0.43",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-svelte": "^3.23.1",
        "husky": "^9.0.11",
        "jwt-decode": "^4.0.0",
        "lint-staged": "^15.2.4",
        "lodash": "^4.18.1",
        "luxon": "^3.7.2",
        "mockserver-client": "^7.6.0",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.1.1",
        "prettier-plugin-svelte": "^3.2.6",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.5",
        "sveltekit-rate-limiter": "^0.8.0",
        "tailwindcss": "^4.3.3",
        "testcontainers": "^12.1.0",
        "tslib": "^2.4.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.57.0",
        "vite": "^8.0.12",
        "vitest": "^4.1.11"
    },
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*",
        "#config": "./src/config/config.js",
        "#config/*": "./src/config/*"
    }
}
