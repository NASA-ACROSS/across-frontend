# Private dynamic env vars
API_URL="http://127.0.0.1:8000/api/v1"

ACROSS_TEST_ACCESS_TOKEN="dummy-token"
ACROSS_SERVER_ID="dummy-id"
ACROSS_SERVER_SECRET="dummy-secret"

# build time static public env vars must have a PUBLIC_ prefix
PUBLIC_BUILD_VERSION="test"

# Set to "local" (not "test") so IS_LOCAL (derived from RUNTIME_ENV) is true during the test run.
# This is required by the ALTCHA captcha suite:
#   1. The register and login-verify routes are gated by localOnlyRoute(), which 404s unless IS_LOCAL,
#      so the e2e tests could not reach those pages otherwise.
#   2. The ALTCHA module resolves its HMAC key at import time: when IS_LOCAL (or build) it uses a
#      built-in dev key; otherwise it reads from AWS SSM, which the test harness never provisions
#      (hooks init() does not run), so the import would throw.
PUBLIC_RUNTIME_ENV="local"